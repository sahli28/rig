{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@rig/web",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@rig/mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "supabase-studio",
      "url": "http://127.0.0.1:55323"
    }
  ]
}
