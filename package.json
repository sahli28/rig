{
  "name": "rig",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test:db:fresh": "supabase db reset && node scripts/test-db.mjs",
    "test:db:concurrency": "node scripts/booking-concurrency.mjs",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/core/src/supabase/types.gen.ts && prettier --write packages/core/src/supabase/types.gen.ts"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "supabase": "^2.2.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
